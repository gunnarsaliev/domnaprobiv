DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Server URL — used to build media file URLs. Set to https://domnaprobiv.com in production,
# http://localhost:3000 in local dev (so image URLs don't point to production).
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 Storage Configuration
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=

# Resend Email Configuration
RESEND_API_KEY=
EMAIL_FROM=info@domnaprobiv.com
EMAIL_TO=info@domnaprobiv.com
